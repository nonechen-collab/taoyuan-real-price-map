# 本專案目前不需要任何金鑰：
# - 實價登錄、桃園市門牌坐標都是免申請的政府開放資料
# - 預售建案補位置用 OpenStreetMap（免金鑰）
# 下面是可選的調整參數（本機執行時才需要；GitHub Actions 用預設值）

# 每次下載內政部資料之間至少間隔幾秒（禮貌下載，預設 10）
PLVR_DELAY=10

# 每次執行最多查幾次 OpenStreetMap、最多花幾秒（Overpass 偶爾很慢，預設 40 次／120 秒）
OSM_LIMIT=40
OSM_BUDGET=120

# 網站部署路徑（GitHub Pages 專案網址的 repo 名稱）
BASE_PATH=/taoyuan-real-price-map/
